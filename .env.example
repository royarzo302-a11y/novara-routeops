DATABASE_URL=sqlite:///./routeops.db
# Local: export DATABASE_URL before starting Uvicorn. Compose automatically reads .env.
COMPOSE_DATABASE_URL=sqlite:////app/storage/routeops.db

# Configure these locally only. A token enables the private geo API and manual approval.
NOVARA_GEO_TOKEN=
NOVARA_GEO_LOCAL_AUTHORIZED=0
NOVARA_NOMINATIM_URL=
NOVARA_OSRM_URL=
NOVARA_GEO_MAP_VERSION=
NOVARA_OSRM_PROFILE=driving
# Clave del contenedor Render. Generar fuera de Git con openssl rand -hex 32.
NOVARA_DEMO_PASSWORD=

# Optional AI experiment; empty means no model is selected. Not used by the hosted demo.
NOVARA_BEDROCK_MODEL_ID=
